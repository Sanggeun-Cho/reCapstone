# 환경변수 예시 파일
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 아직 결정되지 않은 항목(스토리지 D-6, 운영 LLM)은 결정에 따라 바뀔 수 있다.

# --- Database (PostgreSQL + PGVector) ---
DB_URL=jdbc:postgresql://localhost:5432/recapstone
DB_USERNAME=
DB_PASSWORD=

# --- Redis (Refresh Token 저장소) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# 로컬 compose에서는 비워 둔다 (compose의 Redis는 비밀번호 없이 127.0.0.1에만 열림)
REDIS_PASSWORD=

# --- JWT ---
# 32바이트 이상의 임의 문자열
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=P14D

# --- CORS ---
# 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- File Storage (S3 호환) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- LLM (정책.md 6.1) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
